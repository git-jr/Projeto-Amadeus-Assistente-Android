<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="false"
        android:fullBackupContent="@xml/backup_descriptor"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        tools:ignore="AllowBackup,GoogleAppIndexingWarning">

        <!-- LiteRT-LM GPU backend (optional — device-specific) -->
        <uses-native-library android:name="libvndksupport.so" android:required="false" />
        <uses-native-library android:name="libOpenCL.so" android:required="false" />

        <activity
            android:name=".activity.ConfigPrimariaActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:theme="@style/Theme.Amadeus.ConfigPrimaria"
            android:windowSoftInputMode="stateVisible|adjustResize|stateAlwaysHidden" />
        <activity
            android:name=".activity.CadastroInicialActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:theme="@style/Theme.Amadeus.ConfigPrimaria"
            android:windowSoftInputMode="stateVisible|adjustResize|stateAlwaysHidden" />
        <activity
            android:name=".activity.SplashScreenActivity"
            android:exported="true"
            android:theme="@style/Theme.Amadeus.Splash"
            android:windowSoftInputMode="stateVisible|adjustResize|stateAlwaysHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".activity.MainActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="true"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar.Transparent"
            android:windowSoftInputMode="stateVisible|adjustResize|stateAlwaysHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity>
        <activity
            android:name=".activity.ListaSentencaActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar.Transparent"
            android:windowSoftInputMode="stateVisible|adjustResize|stateAlwaysHidden" />
        <activity
            android:name=".activity.AprendizActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar.Transparent"
            android:windowSoftInputMode="stateVisible|adjustResize|stateAlwaysHidden" />
        <activity
            android:name=".activity.SobreActivity"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar.Transparent" />
        <activity
            android:name=".activity.EditarSentencaActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar.Transparent"
            android:windowSoftInputMode="stateVisible|adjustResize|stateAlwaysHidden" />
        <activity
            android:name=".activity.ListaEntidadeActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar.Transparent"
            android:windowSoftInputMode="stateVisible|adjustResize|stateAlwaysHidden" />
        <activity
            android:name=".activity.ListaAcaoActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar.Transparent"
            android:windowSoftInputMode="stateVisible|adjustResize|stateAlwaysHidden" />
        <activity
            android:name=".activity.EditarItemEntidadeNovoActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:theme="@style/Theme.Amadeus.ConfigPrimaria"
            android:windowSoftInputMode="stateVisible|adjustResize|stateAlwaysHidden" />
        <activity
            android:name=".activity.VozConfigActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar.Transparent"
            android:windowSoftInputMode="stateVisible|adjustResize|stateAlwaysHidden" />
        <activity
            android:name=".activity.TrocarVozActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar.Transparent"
            android:windowSoftInputMode="stateVisible|adjustResize|stateAlwaysHidden" />
        <activity
            android:name=".activity.RetroCompatibilidadeActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar.Transparent"
            android:windowSoftInputMode="stateVisible|adjustResize|stateAlwaysHidden" />

        <activity
            android:name=".onboarding.OnboardingActivity"
            android:exported="false"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar.Transparent" />

        <activity
            android:name=".activity.ListaMacrosActivity"
            android:exported="false"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar.Transparent" />

        <activity
            android:name=".activity.EditarMacroActivity"
            android:exported="false"
            android:theme="@style/Theme.Amadeus.Light.NoActionBar" />

        <activity
            android:name=".activity.AgentDashboardActivity"
            android:exported="false"
            android:theme="@style/Theme.Amadeus.Compose" />

        <activity
            android:name=".ui.amadeuspro.AmadeusProActivity"
            android:exported="false"
            android:theme="@style/Theme.Amadeus.Compose" />

        <activity
            android:name=".ui.demoactions.DemoActionsActivity"
            android:exported="false"
            android:theme="@style/Theme.Amadeus.Compose" />

        <activity
            android:name=".ui.litertmodelmanager.LiteRTModelManagerActivity"
            android:exported="false"
            android:theme="@style/Theme.Amadeus.Compose" />

        <activity
            android:name=".activity.AIProviderSelectorActivity"
            android:exported="false"
            android:theme="@style/Theme.Amadeus.Compose" />

        <meta-data
            android:name="preloaded_fonts"
            android:resource="@array/preloaded_fonts" />

        <service
            android:name=".assis.MyAssistantService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>

            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/assist_metadata" />
        </service>
        <service
            android:name=".assis.MyAssistantSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />

        <service
            android:name=".assis.VoiceCommandService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />

        <service
            android:name=".util.voz.EscutadaoraService"
            android:exported="false"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter>
                <action android:name="SERVICE_ESCUTADORA" />
            </intent-filter>
        </service>
        <service
            android:name=".service.GravaHistoricoService"
            android:exported="false" />
        <service
            android:name=".service.AmadeusAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
        <service
            android:name=".service.FloatingButtonAmadeusService"
            android:exported="false"
            android:foregroundServiceType="specialUse|microphone">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="floating_button_overlay" />
        </service>
        <service
            android:name=".service.MacroRecordingOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="recording_overlay" />
        </service>
        <service
            android:name=".firebase.MessasingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="default_channel" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:value="@drawable/ic_logo_white" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:value="@color/colorPrimary" />
    </application>
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

</manifest>
