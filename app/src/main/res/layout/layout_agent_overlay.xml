<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:id="@+id/agentOverlayLayout"
    android:background="@drawable/bg_dynamic_island"
    android:elevation="8dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="18dp"
    android:paddingTop="6dp"
    android:paddingEnd="10dp"
    android:paddingBottom="6dp">

    <ProgressBar
        android:id="@+id/agentProgressIndicator"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="10dp"
        android:indeterminateTint="@color/colorPrimary" />

    <TextView
        android:id="@+id/agentStatusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxWidth="220dp"
        android:singleLine="true"
        android:text="@string/thinking"
        android:textColor="#1A1A1A"
        android:textSize="13sp" />

    <ImageButton
        android:id="@+id/agentCancelButton"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="6dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cancelar"
        android:padding="6dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_close"
        app:tint="@color/colorPrimary" />

</LinearLayout>
