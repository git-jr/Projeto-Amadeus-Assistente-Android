<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_floating_menu"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Área de voz: ícone + texto ouvido -->
        <LinearLayout
            android:id="@+id/areaVoz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_floating_button"
                android:contentDescription="@null"
                android:padding="10dp"
                android:src="@drawable/ic_mic"
                android:tint="#FFFFFF" />

            <TextView
                android:id="@+id/textoOuvidoTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:gravity="start"
                android:minHeight="40dp"
                android:text="@string/ouvindo"
                android:textColor="#1A1A1A"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Divisor -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="12dp"
            android:background="#E0E0E0" />

        <!-- Campo de digitação manual -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/campoComandoEditText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/ouvir_dica"
                android:imeOptions="actionSend"
                android:padding="8dp"
                android:maxLength="500"
                android:textColor="#1A1A1A"
                android:textColorHint="#9E9E9E"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/enviarComandoButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_floating_button"
                android:contentDescription="@null"
                android:padding="10dp"
                android:src="@drawable/ic_send" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancelarOuvirButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="13sp"
                app:icon="@drawable/ic_close"
                app:iconGravity="textStart"
                app:iconSize="20dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/minimizarOuvirButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="13sp"
                app:icon="@drawable/ic_arrow_down"
                app:iconGravity="textStart"
                app:iconSize="20dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/irParaAmadeusButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="13sp"
                app:icon="@drawable/ic_logo_white"
                app:iconGravity="textStart"
                app:iconSize="20dp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
